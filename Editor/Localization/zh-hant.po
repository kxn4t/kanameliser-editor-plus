msgid "componentCopier.mapping.group.others"
msgstr "其他物件"

msgid "componentCopier.mapping.note.boneMissing"
msgstr "找不到骨骼"

msgid "componentCopier.mapping.reason.renamedChild"
msgstr "僅名稱變更（.1、prefix / suffix）"

msgid "componentCopier.action.withPrefab"
msgstr "透過 Prefab 新增"

msgid "componentCopier.mapping.note.prefab"
msgstr "新增 Prefab"

#, csharp-format
msgid "componentCopier.report.prefabs"
msgstr "其中 {0} 個以 Prefab 實例的形式新增。其中的 {1} 個元件會依複製來源的狀態複製。"

msgid "componentCopier.report.prefabsOnly"
msgstr "其中 {0} 個以 Prefab 實例的形式新增。"

#, csharp-format
msgid "componentCopier.report.appliedPrefabs"
msgstr "已新增 {0} 個 Prefab。"

msgid "componentCopier.action.leftOut"
msgstr "不新增"

msgid "componentCopier.action.leftOut:tooltip"
msgstr "Prefab 會整體新增，因此新增後會從實例中刪除此元件。可透過 Prefab 的 Overrides 還原。"

#, csharp-format
msgid "componentCopier.report.leftOut"
msgstr "取消勾選的 {0} 個元件將在新增 Prefab 後刪除，因此變空的 {1} 個物件也會一併刪除。"

#, csharp-format
msgid "componentCopier.report.appliedLeftOut"
msgstr "已從新增的 Prefab 中刪除取消勾選的 {0} 個元件和 {1} 個物件。"

#, csharp-format
msgid "componentCopier.report.removeFailed"
msgstr "{0} 個元件被其他元件依賴，無法刪除。"

msgid "componentCopier.prefabs.title"
msgstr "複製目標中缺少的物件"

msgid "componentCopier.prefabs.title:tooltip"
msgstr "複製來源中有而複製目標中沒有的 Prefab 和空物件。已選元件所需要的會自動新增。像只有網格的帽子或未被任何地方參照的錨點那樣的物件，勾選後也可以新增。骨骼不在此列。"

msgid "componentCopier.prefabs.emptyChildren:tooltip"
msgstr "其下的 {0} 個空物件也會一併建立"

#, csharp-format
msgid "componentCopier.prefabs.summary"
msgstr "新增 {0} 個"

msgid "componentCopier.prefabs.status.add"
msgstr "新增"

msgid "componentCopier.prefabs.status.withComponents"
msgstr "隨元件一併新增"

msgid "componentCopier.prefabs.blocked"
msgstr "放置此物件的父物件尚未確定。請在對應關係區段確認父物件，或開啟「建立缺少的物件」。如果父物件是複製目標中不存在的骨骼，則無法建立。"

msgid "componentCopier.groupBy.type"
msgstr "依類型"

msgid "componentCopier.groupBy.type:tooltip"
msgstr "依元件類型將清單分組。每一列是一個物件。"

msgid "componentCopier.groupBy.object"
msgstr "依物件"

msgid "componentCopier.search.regex:tooltip"
msgstr "將搜尋文字視為正規表示式（不區分大小寫）。比對對象為物件路徑和元件類型名稱。例：Skirt|Hair"

msgid "componentCopier.groupBy.object:tooltip"
msgstr "依物件將清單分組。每一列是該物件上的一個元件。"

msgid "componentCopier.settings.unresolved"
msgstr "未解析的參照"

msgid "componentCopier.settings.unresolved:tooltip"
msgstr "元件內的參照在複製目標中沒有對應物件時的處理方式。在對應關係區段指定對應物件即可解決"

msgid "componentCopier.unresolvedPolicy.clear"
msgstr "以 None 複製"

msgid "componentCopier.unresolvedPolicy.skipComponent"
msgstr "略過整個元件"

msgid "componentCopier.blocked.unresolvedReference"
msgstr "參照在複製目標中沒有對應物件，依設定略過此元件。在對應關係區段指定對應物件後即會複製。"

#, csharp-format
msgid "componentCopier.report.heldBack"
msgstr "{0} 個元件因參照未解析而依設定略過。"

msgid "componentCopier.report.cause.heldBack"
msgstr "被參照的元件被略過"

msgid "componentCopier.action.skipUnresolved"
msgstr "未解析，略過"

#, csharp-format
msgid "componentCopier.row.heldBack:tooltip"
msgstr "{0} 個參照在複製目標中沒有對應物件，因此依設定略過此元件。"
